{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "separate-pull-requests": false,
  "include-component-in-tag": true,
  "packages": {
    "packages/jen": {
      "component": "jen",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/jen'].version"
        }
      ]
    },
    "packages/pack-cpp": {
      "component": "pack-cpp",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/pack-cpp'].version"
        }
      ]
    },
    "packages/pack-glsl": {
      "component": "pack-glsl",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/pack-glsl'].version"
        }
      ]
    },
    "packages/pack-web": {
      "component": "pack-web",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/pack-web'].version"
        }
      ]
    },
    "packages/pack-js": {
      "component": "pack-js",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/pack-js'].version"
        }
      ]
    },
    "packages/pack-yeoman": {
      "component": "pack-yeoman",
      "extra-files": [
        {
          "type": "json",
          "path": "/package-lock.json",
          "jsonpath": "$.packages['packages/pack-yeoman'].version"
        }
      ]
    }
  }
}
