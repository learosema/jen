{
  "name": "@codejen/pack-web",
  "version": "0.0.0",
  "description": "jen pack for web development: contrast-checked color palettes, CUBE CSS layers, reset and base styles, buttons",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learosema/jen.git",
    "directory": "packages/pack-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretypecheck": "npm run build --prefix ../jen",
    "prebuild": "npm run build --prefix ../jen",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test pack-web.test.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "jen-pack",
    "css",
    "design-tokens",
    "wcag",
    "cube-css"
  ],
  "author": "Lea Rosema",
  "license": "ISC",
  "peerDependencies": {
    "@codejen/jen": "^2.0.0"
  },
  "devDependencies": {
    "@codejen/jen": "^2.0.0",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3"
  }
}
