{
  "name": "@codejen/pack-yeoman",
  "version": "2.0.1",
  "description": "jen pack that runs Yeoman generators, JHipster included, through jen's plan: never interactive, nothing written before you see it",
  "homepage": "https://learosema.github.io/jen/yeoman.html",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learosema/jen.git",
    "directory": "packages/pack-yeoman"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretypecheck": "npm run build --prefix ../jen",
    "prebuild": "npm run build --prefix ../jen",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test pack-yeoman.test.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "jen-pack",
    "yeoman",
    "jhipster"
  ],
  "author": "Lea Rosema",
  "license": "ISC",
  "peerDependencies": {
    "@codejen/jen": "^2.0.0 || ^3.0.0"
  },
  "devDependencies": {
    "@codejen/jen": "^2.0.0 || ^3.0.0",
    "@types/node": "^26.6.3",
    "mem-fs": "^6.0.0",
    "typescript": "^6.0.3",
    "yeoman-generator": "^10.0.1"
  }
}
