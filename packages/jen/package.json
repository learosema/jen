{
  "name": "@codejen/jen",
  "version": "3.2.0",
  "description": "",
  "homepage": "https://learosema.github.io/jen/",
  "type": "module",
  "bin": {
    "jen": "./dist/jen.js"
  },
  "main": "./dist/jen.js",
  "types": "./dist/jen.d.ts",
  "exports": {
    ".": {
      "types": "./dist/jen.d.ts",
      "default": "./dist/jen.js"
    },
    "./js": {
      "types": "./dist/js.d.ts",
      "default": "./dist/js.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learosema/jen.git",
    "directory": "packages/jen"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rm -rf dist && esbuild src/jen.ts src/js.ts --bundle --platform=node --format=esm --target=node24 --outdir=dist && tsc -p tsconfig.build.json && chmod +x dist/jen.js",
    "typecheck": "tsc",
    "test": "node --test jen.test.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^26.6.3",
    "esbuild": "^0.28.2",
    "typescript": "^6.0.3"
  }
}
