{
  "name": "@codejen/jen",
  "version": "2.0.0",
  "description": "",
  "type": "module",
  "bin": {
    "jen": "./dist/jen.js"
  },
  "main": "./dist/jen.js",
  "types": "./dist/jen.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learosema/jen.git",
    "directory": "packages/jen"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
