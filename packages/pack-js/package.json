{
  "name": "@codejen/pack-js",
  "version": "2.0.0",
  "description": "jen pack for TypeScript and JavaScript: Vite and esbuild projects, web components, ARIA keyboard patterns and type patterns, as TypeScript, JSDoc or plain JavaScript",
  "homepage": "https://learosema.github.io/jen/js.html",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/learosema/jen.git",
    "directory": "packages/pack-js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pretypecheck": "npm run build --prefix ../jen",
    "pretest": "npm run build --prefix ../jen",
    "prebuild": "npm run build --prefix ../jen",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test pack-js.test.ts",
    "prepublishOnly": "npm test && npm run typecheck && npm run build"
  },
  "keywords": [
    "jen-pack",
    "typescript",
    "javascript",
    "jsdoc"
  ],
  "author": "Lea Rosema",
  "license": "ISC",
  "peerDependencies": {
    "@codejen/jen": "^3.2.0 || ^4.0.0"
  },
  "devDependencies": {
    "@codejen/jen": "^3.2.0 || ^4.0.0",
    "@types/node": "^26.6.3",
    "typescript": "^6.0.3"
  }
}
